# Image Search PoC - 環境変数のテンプレート
# 実際の値は .env に書いてください（.env は Git にコミットしません）。

# Elastic Cloud Serverless のエンドポイント URL
ELASTIC_URL=

# Elastic の API キー（Kibana の Stack Management > API keys で作成）
ELASTIC_API_KEY=

# AWS IAM ユーザーのアクセスキー
AWS_ACCESS_KEY_ID=

# AWS IAM ユーザーのシークレットアクセスキー
AWS_SECRET_ACCESS_KEY=

# AWS リージョン（このPoCは東京リージョンを使用: ap-northeast-1）
AWS_REGION=

# S3 バケット名（全AWSで一意。例: image-search-poc-yourname-20260522）
S3_BUCKET_NAME=

# S3 内でアップロード先となるフォルダ名（推奨: poc-uploads）
S3_UPLOAD_PREFIX=

# Elastic のインデックス名（推奨: image-search-poc）
INDEX_NAME=
